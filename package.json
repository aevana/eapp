{
  "name": "electricity-bills-tracker",
  "version": "1.0.0",
  "description": "Electric Transformer Electricity Bills Tracker",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "android:init": "cap add android && cap sync android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "cap sync android && cd android && ./gradlew assembleDebug",
    "migrate": "node scripts/generate-migration.js"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0",
    "nodemon": "^3.0.2"
  }
}
